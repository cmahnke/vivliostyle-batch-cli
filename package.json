{
  "name": "@projektemacher/vivliostyle-batch-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "A vivliostyle-cli with more options for batch processing",
  "bin": {
    "vivliostyle-cli": "dist/vivliostyle-batch-cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "npx vitest",
    "build": "npx rimraf dist/* && npx rollup -c",
    "start": "node dist/vivliostyle-batch-cli.js",
    "format": "npx prettier . --check",
    "clean": "npx rimraf dist/*",
    "lint": "npx tsc && eslint . -c eslint.config.mjs --report-unused-disable-directives --max-warnings 0",
    "site:collect": "node site/collect-manifest.mjs",
    "site:dev": "node site/collect-manifest.mjs --sample && vite dev site",
    "site:build": "vite build site"
  },
  "dependencies": {
    "@vivliostyle/viewer": "^2.46.0",
    "commander": "^15.0.0",
    "jsdom": "^31.0.0",
    "loglevel": "^1.9.2",
    "mime-types": "^3.0.2",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.16.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/serve-static": "^2.2.0",
    "aframe": "^1.8.0",
    "d3": "^7.9.2",
    "echarts": "^6.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "marked": "^18.1.3",
    "openseadragon": "^6.1.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1",
    "three": "^0.187.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/vivliostyle-batch-cli.js"
  },
  "files": [
    "dist",
    "src",
    "scripts/convert-docs-pdf.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pdf",
    "css",
    "vivliostyle",
    "print"
  ],
  "bugs": {
    "url": "https://github.com/cmahnke/vivliostyle-batch-cli/issues"
  },
  "repository": {
    "url": "git+https://github.com/cmahnke/vivliostyle-batch-cli.git"
  },
  "homepage": "https://github.com/cmahnke/vivliostyle-batch-cli#readme"
}
